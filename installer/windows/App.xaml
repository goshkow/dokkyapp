<Application x:Class="DokkySetup.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <!-- палитра и шрифты приложения (frontend/src/styles/tokens.css) -->
    <Color x:Key="BgColor">#141414</Color>
    <Color x:Key="AccentColor">#438DFF</Color>
    <SolidColorBrush x:Key="Bg" Color="#141414" />
    <SolidColorBrush x:Key="Panel" Color="#1D1D1D" />
    <SolidColorBrush x:Key="Field" Color="#2C2C2C" />
    <SolidColorBrush x:Key="Hover" Color="#343434" />
    <SolidColorBrush x:Key="Line" Color="#2E2E2E" />
    <SolidColorBrush x:Key="Text" Color="#F5F5F5" />
    <SolidColorBrush x:Key="Muted" Color="#A3A3A3" />
    <SolidColorBrush x:Key="Faint" Color="#777777" />
    <SolidColorBrush x:Key="Accent" Color="#438DFF" />
    <SolidColorBrush x:Key="AccentHover" Color="#5A9BFF" />
    <SolidColorBrush x:Key="AccentPressed" Color="#3279E6" />
    <SolidColorBrush x:Key="Danger" Color="#EE7B83" />
    <SolidColorBrush x:Key="Positive" Color="#6FC99B" />
    <FontFamily x:Key="Inter">pack://application:,,,/Fonts/#Inter</FontFamily>
    <FontFamily x:Key="Unbounded">pack://application:,,,/Fonts/#Unbounded SemiBold</FontFamily>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Inter}" />
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
      <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <!-- основная кнопка: как .btn-primary в приложении -->
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="FontFamily" Value="{StaticResource Inter}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="Height" Value="44" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Ring" CornerRadius="14" BorderThickness="2" BorderBrush="Transparent" Margin="-3" />
              <Border x:Name="Body" CornerRadius="12" Background="{TemplateBinding Background}" SnapsToDevicePixels="True" />
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextElement.Foreground="White" TextElement.FontWeight="SemiBold" TextElement.FontSize="15" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Body" Property="Background" Value="{StaticResource AccentHover}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Body" Property="Background" Value="{StaticResource AccentPressed}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Ring" Property="BorderBrush" Value="#80438DFF" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Body" Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Background" Value="#C9505A" />
    </Style>

    <!-- вторичная кнопка: прозрачная с тонкой рамкой -->
    <Style x:Key="SecondaryButton" TargetType="Button">
      <Setter Property="FontFamily" Value="{StaticResource Inter}" />
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="Height" Value="44" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Body" CornerRadius="12" Background="{StaticResource Field}" SnapsToDevicePixels="True">
              <TextBlock Text="{TemplateBinding Content}" FontWeight="Medium" FontSize="15"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Body" Property="Background" Value="{StaticResource Hover}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Body" Property="Background" Value="{StaticResource Hover}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ссылка-кнопка «Изменить» -->
    <Style x:Key="LinkButton" TargetType="Button">
      <Setter Property="FontFamily" Value="{StaticResource Inter}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Body" CornerRadius="8" Padding="10,5" Background="Transparent">
              <TextBlock x:Name="Label" Text="{TemplateBinding Content}" FontSize="13" FontWeight="Medium"
                         Foreground="{StaticResource Accent}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Body" Property="Background" Value="#1F438DFF" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Body" Property="Background" Value="#1F438DFF" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Faint}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- кнопки заголовка окна -->
    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="40" />
      <Setter Property="FontFamily" Value="{StaticResource Icons}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Body" Background="Transparent">
              <TextBlock x:Name="Glyph" Text="{TemplateBinding Content}" FontFamily="{TemplateBinding FontFamily}"
                         FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Body" Property="Background" Value="#1AFFFFFF" />
                <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Text}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Body" Background="Transparent" CornerRadius="0,12,0,0">
              <TextBlock x:Name="Glyph" Text="{TemplateBinding Content}" FontFamily="{TemplateBinding FontFamily}"
                         FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Body" Property="Background" Value="#C42B1C" />
                <Setter TargetName="Glyph" Property="Foreground" Value="White" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- флажок: скруглённый квадрат с галочкой, как в настройках приложения -->
    <Style TargetType="CheckBox">
      <Setter Property="FontFamily" Value="{StaticResource Inter}" />
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border x:Name="Box" Width="18" Height="18" CornerRadius="5" BorderThickness="1.5"
                      BorderBrush="#5A5A5A" Background="Transparent" VerticalAlignment="Center">
                <Path x:Name="Mark" Data="M 3.5,9 L 7.2,12.5 L 14,5" Stroke="White" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Opacity="0" Margin="-1.5" />
              </Border>
              <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{TemplateBinding Content}" FontSize="14"
                         Foreground="{StaticResource Text}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}" />
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter TargetName="Mark" Property="Opacity" Value="1" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="#8A8A8A" />
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsMouseOver" Value="True" />
                  <Condition Property="IsChecked" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentHover}" />
                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentHover}" />
              </MultiTrigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentHover}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
